# Server-only Runway API key. Never expose this as NEXT_PUBLIC_*.
RUNWAYML_API_SECRET=key_REPLACE_ME

# Existing MVP avatar created from the provided inspo image.
NEXT_PUBLIC_RUNWAY_AVATAR_ID=6824a3e0-f37f-455a-b1d4-3140111a83bf

# Optional override; defaults to https://api.dev.runwayml.com
RUNWAY_BASE_URL=https://api.dev.runwayml.com
